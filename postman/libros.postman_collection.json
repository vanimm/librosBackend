{
  "info": {
    "name": "Backend Libros",
    "description": "Colección educativa para probar el CRUD de libros en http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET todos los libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/libros",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["libros"]
        }
      }
    },
    {
      "name": "GET libro por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/libros/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["libros", "1"]
        }
      }
    },
    {
      "name": "POST crear libro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortázar\",\n  \"editorial\": \"Alfaguara\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/libros",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["libros"]
        }
      }
    },
    {
      "name": "PUT actualizar libro",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela (edición revisada)\",\n  \"autor\": \"Julio Cortázar\",\n  \"editorial\": \"Alfaguara\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/libros/3",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["libros", "3"]
        }
      }
    },
    {
      "name": "DELETE eliminar libro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/libros/3",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["libros", "3"]
        }
      }
    }
  ]
}
